<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="A personal movie library">
  <title><%= title || 'Movie Library' %> | Movie Library</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <div class="wrapper">
    <%- include('partials/navbar') %>
    <main>
      <section class="messages">
        <%- include('partials/messages', { message, error }) %>
      </section>
      <%- body %>
    </main>
    <footer>
      <p>&copy; <%= new Date().getFullYear() %> Movie Library · Built with Node.js &amp; MongoDB</p>
    </footer>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
